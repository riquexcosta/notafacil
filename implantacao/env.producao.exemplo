# /opt/notafacil/app/server/.env na VPS (permissão 600, dono notafacil)
NODE_ENV=production
PORT=3333
DB_PATH=/var/lib/notafacil/notafacil.db

# Segredo das sessões: gere com  openssl rand -hex 48
JWT_SECRET=

# Instalação de demonstração: sem cadastro público, só a conta demo.
CADASTRO_ABERTO=false

# nginx na mesma máquina repassa o IP real do cliente.
TRUST_PROXY=loopback

# Cliente e API na mesma origem; CORS só é usado se o cliente ficar em outro endereço.
CORS_ORIGENS=https://DOMINIO

# Token da Infosimples (consulta por chave/QR Code).
INFOSIMPLES_TOKEN=
NFE_MODO_DEMO=
