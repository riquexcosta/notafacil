# /etc/systemd/system/notafacil-demo.service
# Restaura a conta de demonstração (demo@notafacil.app). Só ela é apagada e
# recriada: as contas criadas pelo cadastro e suas notas são preservadas.
[Unit]
Description=NotaFácil: restaura a conta de demonstração

[Service]
Type=oneshot
User=notafacil
Group=notafacil
WorkingDirectory=/opt/notafacil/app/server
EnvironmentFile=/opt/notafacil/app/server/.env
ExecStart=/opt/notafacil/node/bin/node src/seed.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/notafacil
