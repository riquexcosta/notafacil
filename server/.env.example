# Copie este arquivo para .env (mesma pasta) e preencha. O .env não vai para o Git.

# Token da API Infosimples (painel > Tokens). Sem token, a leitura por chave/QR
# usa a consulta assistida (link da SEFAZ + importação do XML).
INFOSIMPLES_TOKEN=

# Modo demonstração: 1 = consulta por chave gera itens sintéticos do catálogo local.
NFE_MODO_DEMO=

# Produção: com NODE_ENV=production, a API só inicia se JWT_SECRET estiver definido.
# Use um valor longo e aleatório. CORS_ORIGENS lista as origens do cliente, separadas por vírgula.
NODE_ENV=
JWT_SECRET=
CORS_ORIGENS=
