  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.1"
  },
  "type": "module"
}