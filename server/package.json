{
  "name": "notafacil-api",
  "version": "1.0.0",
  "description": "API do NotaFácil — controle de notas fiscais eletrônicas e comparação de preços",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "start:demo": "node --env-file-if-exists=.env src/index.js --demo",
    "seed": "node src/seed.js",
    "sonda:infosimples": "node --env-file-if-exists=.env scripts/infosimples-sonda.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [],
